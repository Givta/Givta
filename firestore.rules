rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ✅ SECURE PRODUCTION RULES - ACTIVE FOR FIRESTORE SECURITY
    // Used Firebase Auth UIDs and proper access controls

    // ============================ HELPER FUNCTIONS ============================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isValidUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwnTicket(ticketId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/supportTickets/$(ticketId)) &&
             get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid;
    }

    // ============================ USER COLLECTIONS ============================

    // Users collection - Private profiles, but public info for tipping/search
    match /users/{userId} {
      allow read: if isOwner(userId) || isAuthenticated();  // Allow authenticated users to read public user info
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow read: if isAdmin();
    }

    // Wallets collection - Private financial data
    match /wallets/{walletId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Tips collection - Private transaction data
    match /tips/{tipId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAdmin();
      allow read: if isAdmin();
    }

    // Transactions collection - Private payment history
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow read, write: if isAdmin();
    }

    // Notifications collection - Private user notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Referrals collection - Private referral relationships
    match /referrals/{referralId} {
      allow read: if isAuthenticated() &&
        (resource.data.referrerId == request.auth.uid ||
         resource.data.referredId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow read: if isAdmin();
    }

    // KYC collection - Private verification data
    match /kyc/{kycId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ================================ ADMIN COLLECTIONS ===============================

    // Tip Links collection - Public read for external tipping
    match /tipLinks/{tipLinkId} {
      allow read: if true;  // Public can read tip links
      allow read, write: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Admin dashboards and analytics
    match /systemLogs/{logId} { allow read, write: if isAdmin(); }
    match /systemSettings/{settingId} { allow read, write: if isAdmin(); }
    match /notificationTemplates/{templateId} { allow read, write: if isAdmin(); }
    match /maintenanceRecords/{recordId} { allow read, write: if isAdmin(); }
    match /webhookLogs/{logId} { allow read, write: if isAdmin(); }
    match /config/{document=**} { allow read, write: if isAdmin(); }
    match /analytics/{document=**} {
      allow write: if isAdmin();
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    /* =========================== DEVELOPMENT RULES (OVERRIDDEN ABOVE) ============================

    // When the dev rule above is removed, the following rules will be active.
    // These are the same rules used in production but without the dev override.

    // ============================ HELPER FUNCTIONS ============================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isValidUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwnTicket(ticketId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/supportTickets/$(ticketId)) &&
             get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid;
    }

    function isCreatorOfChallenge(challengeId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/challenges/$(challengeId)) &&
             get(/databases/$(database)/documents/challenges/$(challengeId)).data.userId == request.auth.uid;
    }

    function isCreatorOfSponsoredChallenge(challengeId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/sponsoredChallenges/$(challengeId)) &&
             get(/databases/$(database)/documents/sponsoredChallenges/$(challengeId)).data.userId == request.auth.uid;
    }

    // ============================ USER COLLECTIONS ============================

    // Users collection - Core user profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow read: if isAuthenticated() && request.query.limit <= 10;
      allow read, write: if isAdmin();
    }

    // Wallets collection - User financial data
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Transactions collection - Payment history
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow read, delete: if isAdmin();
    }

    // Referrals collection - Referral relationships
    match /referrals/{referralId} {
      allow read: if isAuthenticated() &&
        (resource.data.referrerId == request.auth.uid ||
         resource.data.referredId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow read: if isAdmin();
    }

    // Notifications collection - User notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Tips collection - Direct tipping records
    match /tips/{tipId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAdmin();
      allow read: if isAdmin();
    }

    // KYC collection - Know Your Customer data
    match /kyc/{kycId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // WhatsApp Sessions collection - WhatsApp business integration
    match /whatsapp_sessions/{sessionId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Two Factor Backup Codes collection - 2FA security
    match /twoFactorBackupCodes/{codeId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Two Factor Setup collection - 2FA configuration
    match /twoFactorSetup/{setupId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // External Tips collection - Tips from public links
    match /externalTips/{tipId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
        (resource.data.tipperId == request.auth.uid ||
         resource.data.creatorId == request.auth.uid);
      allow read, write: if isAdmin();
    }

    // Tip Links collection - Public tipping URLs
    match /tipLinks/{tipLinkId} {
      allow read: if true;
      allow read, write: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Feedback collection - User feedback
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read, update: if isAdmin();
    }

    // ============================ CHALLENGE SYSTEM ============================

    // Challenges collection - User-created challenges
    match /challenges/{challengeId} {
      allow read: if isAuthenticated() && resource.data.isPublic == true;
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Sponsored Challenges collection - Admin/business sponsored challenges
    match /sponsoredChallenges/{challengeId} {
      allow read: if resource.data.status == 'active' ||
                   resource.data.status == 'approved' ||
                   resource.data.status == 'completed';
      allow read: if isCreatorOfSponsoredChallenge(challengeId);
      allow create: if isAuthenticated();
      allow read, write: if isAdmin();
    }

    // Challenge Tips collection - Tips within challenges
    match /challengeTips/{tipId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && isCreatorOfChallenge(resource.data.challengeId);
      allow read: if isAuthenticated() && request.query.limit <= 100;
      allow read, write: if isAdmin();
    }

    // Challenge Types collection - Predefined challenge templates
    match /challengeTypes/{challengeTypeId} {
      allow read: if isAuthenticated();
      allow read, write: if isAdmin();
    }

    // Achievements collection - Gamification achievements
    match /achievements_v2/{achievementId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow read, write: if isAdmin();
    }

    // User Stats collection - User gamification data
    match /user_stats_v2/{statsId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAdmin();
      allow read: if isAdmin();
    }

    // Ranking Rules collection - Gamification rules
    match /ranking_rules_v2/{document=**} {
      allow read, write: if isAdmin();
    }

    // ============================ ADMIN SYSTEM ============================

    // System Logs collection - Comprehensive logging
    match /systemLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // System Settings collection - Platform configuration
    match /systemSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Notification Templates collection - Email/push templates
    match /notificationTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Maintenance Records collection - System maintenance logs
    match /maintenanceRecords/{recordId} {
      allow read, write: if isAdmin();
    }

    // Support Tickets collection - Customer support
    match /supportTickets/{ticketId} {
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isOwnTicket(ticketId);
      allow read, write: if isAdmin();
    }

    // Support Messages collection - Ticket conversations
    match /supportMessages/{messageId} {
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        isOwnTicket(request.resource.data.ticketId);
      allow read: if isAuthenticated() && isOwnTicket(resource.data.ticketId);
      allow read, write: if isAdmin();
    }

    // ============================ UTILITY COLLECTIONS ============================

    // Config collection - Application configuration
    match /config/{document=**} {
      allow read, write: if isAdmin();
    }

    // Analytics collection - Usage analytics
    match /analytics/{document=**} {
      allow write: if isAdmin();
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // Webhook Logs collection - Payment webhooks
    match /webhookLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // ============================ RATE LIMITING ============================

    match /{document=**} {
      allow write: if isAuthenticated() &&
        (request.auth.token.lastWriteTime == null ||
         (request.time.toMillis() - request.auth.token.lastWriteTime.toMillis()) > 1000);
    }

    =========================== END DEVELOPMENT RULES ============================ */
  }
}
    
    // 🔒 PRODUCTION RULES BELOW (currently overridden by dev rule above)
    // Uncomment the production rules and remove the dev rule above when ready
    
    /*
