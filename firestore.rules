      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
      allow read: if isAdmin();
    }

    // Referrals collection
    match /referrals/{referralId} {
      allow read: if isAuthenticated() &&
        (resource.data.referrerId == request.auth.uid ||
         resource.data.referredId == request.auth.uid);
      allow read: if isAuthenticated() && resource.data.referrerId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow read: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Tips collection
    match /tips/{tipId} {
      allow read: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid ||
         resource.data.recipientId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAdmin();
      allow read: if isAdmin();
    }

    // WhatsApp Sessions collection
    match /whatsapp_sessions/{sessionId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Tip Links collection
    match /tipLinks/{tipLinkId} {
      allow read, write: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.creatorId == request.auth.uid;
      allow read: if true;
      allow update: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Two Factor Backup Codes collection
    match /twoFactorBackupCodes/{codeId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // External Tips collection
    match /externalTips/{tipId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
        (resource.data.tipperId == request.auth.uid ||
         resource.data.creatorId == request.auth.uid);
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow read, create: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    // KYC collection
    match /kyc/{kycId} {
      allow read, create: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // Webhook Logs collection
    match /webhookLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Analytics collection
    match /analytics/{document=**} {
      allow write: if isAdmin();
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // Challenges collection
    match /challenges/{challengeId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && request.query.limit <= 50;
      allow read, write: if isAdmin();
      allow read: if isAuthenticated() &&
        (resource.data.isPublic == true || resource.data.userId == request.auth.uid);
      allow read: if resource.data.isPublic == true;
    }

    // Achievements collection
    match /achievements_v2/{achievementId} {
      allow read: if isAuthenticated();
      allow read: if isAuthenticated() && request.query.limit <= 100;
      allow create, update: if isAdmin();
      allow read, write: if isAdmin();
    }

    // User Stats collection
    match /user_stats_v2/{statsId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAdmin();
      allow read: if isAdmin();
    }

    // Ranking Rules collection
    match /ranking_rules_v2/{document=**} {
      allow read, write: if isAdmin();
    }

    // Challenge Types collection
    match /challengeTypes/{challengeTypeId} {
      allow read: if isAuthenticated();
      allow read: if isAuthenticated() && request.query.limit <= 20;
      allow write: if isAdmin();
    }

    // Challenge Tips collection
    match /challengeTips/{tipId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/challenges/$(resource.data.challengeId)) &&
        get(/databases/$(database)/documents/challenges/$(resource.data.challengeId)).data.userId == request.auth.uid;
      allow read: if isAuthenticated() && request.query.limit <= 100;
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    // System configuration
    match /config/{document=**} {
      allow read, write: if isAdmin();
    }

    // Rate limiting
    match /{document=**} {
      allow write: if isAuthenticated() &&
        request.auth.token.lastWriteTime == null ||
        (request.time.toMillis() - request.auth.token.lastWriteTime.toMillis()) > 1000;
    }

    // ================================ ADMIN DASHBOARD COLLECTIONS ===============================

// System Logs collection - Admin only
match /systemLogs/{logId} {
  allow read, write: if isAdmin();
}

// System Settings collection - Admin read/write
match /systemSettings/{settingId} {
  allow read, write: if isAdmin();
}

// Notification Templates collection - Admin only
match /notificationTemplates/{templateId} {
  allow read, write: if isAdmin();
}

// Maintenance Records collection - Admin only
match /maintenanceRecords/{recordId} {
  allow read, write: if isAdmin();
}

// Support Tickets collection
match /supportTickets/{ticketId} {
  allow create: if isAuthenticated() &&
    request.resource.data.userId == request.auth.uid;
  allow read: if isAuthenticated() &&
    resource.data.userId == request.auth.uid;
  allow read, write: if isAdmin();
}

// Support Messages collection
match /supportMessages/{messageId} {
  allow create: if isAuthenticated() &&
    request.resource.data.senderId == request.auth.uid &&
    isOwnTicket(request.resource.data.ticketId);
  allow read: if isAuthenticated() &&
    isOwnTicket(resource.data.ticketId);
  allow read, write: if isAdmin();
}

// Sponsored Challenges collection (already exists)
// Rules ensure public can read approved, users can create, admins manage

    */
  }
}
