# ----------------------------------------------------
# Givta Environment Configuration
# ----------------------------------------------------
# Combined development and production settings
# Comment/uncomment sections as needed

# ==================== ENVIRONMENT SETTINGS ====================
# Set to 'development' for local testing, 'production' for live app
EXPO_PUBLIC_ENVIRONMENT=production
NODE_ENV=production

# ==================== API CONFIGURATION ====================
# For local development (when running backend locally):
# Use your computer's local network IP address (not localhost)
# Find your IP with: ipconfig (Windows) or ifconfig (Mac/Linux)
#EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3002/api
# EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:3002

# For phone hotspot connection (laptop connected to phone hotspot)
#EXPO_PUBLIC_API_BASE_URL=http://10.13.248.69:5000/api
#EXPO_PUBLIC_BACKEND_URL=http://10.13.248.69:5000

# PRODUCTION BACKEND (after Render deployment succeeds)
EXPO_PUBLIC_API_BASE_URL=https://givta-backend.onrender.com/api
EXPO_PUBLIC_BACKEND_URL=https://givta-backend.onrender.com

# For web development (when running expo start --web)
# Web runs on different port but needs to connect to backend on 3002
#EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
#EXPO_PUBLIC_BACKEND_URL=http://localhost:5000



# For production (deployed backend on Render):
#EXPO_PUBLIC_API_BASE_URL=https://givta-backend.onrender.com/api
#EXPO_PUBLIC_BACKEND_URL=https://givta-backend.onrender.com

# API timeout (in milliseconds)
EXPO_PUBLIC_API_TIMEOUT=10000

