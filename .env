# ==================== FEATURE FLAGS ====================
# Development (enable all features for testing)
EXPO_PUBLIC_ENABLE_ANALYTICS=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_REFERRAL_SYSTEM=true
EXPO_PUBLIC_ENABLE_TIPPING=true
# Production settings are commented out below
#EXPO_PUBLIC_ENABLE_ANALYTICS=true
#EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
#EXPO_PUBLIC_ENABLE_REFERRAL_SYSTEM=true
#EXPO_PUBLIC_ENABLE_TIPPING=true

# ==================== SECURITY ====================
# IMPORTANT: Encryption keys should not be exposed on the client-side.
# Move this to your backend server's environment variables.
ENCRYPTION_KEY=dev_encryption_key_123456789
# Production encryption key (use a strong random key on your server):
# ENCRYPTION_KEY=your_production_encryption_key_here

# ==================== DEVELOPMENT DEBUGGING ====================
# Enable for development debugging
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=debug


