# Firebase Configuration
# Get these values from your Firebase project settings
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
EXPO_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here

# Paystack Configuration
# Get these from your Paystack dashboard
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_key_here
EXPO_PUBLIC_PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_here

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://192.168.206.2:3000/api
EXPO_PUBLIC_BACKEND_URL=http://192.168.206.2:3000

# Environment Settings
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

# App Configuration
EXPO_PUBLIC_APP_NAME=Givta
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_SUPPORT_EMAIL=support@givta.com
EXPO_PUBLIC_WHATSAPP_NUMBER=+2341234567890

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_ENABLE_REFERRAL_SYSTEM=true
EXPO_PUBLIC_ENABLE_TIPPING=true

# Security
EXPO_PUBLIC_ENCRYPTION_KEY=your_encryption_key_here

# Third-party Services
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
EXPO_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token_here
