{
  "expo": {
    "name": "Givta",
    "slug": "givta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "givta",
    "backgroundColor": "#4B0082",
    "primaryColor": "#4B0082",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4B0082"
    },

    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.givta.app",
      "buildNumber": "1.0.0",
      "requireFullScreen": false,
      "isTabletOnly": false,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera for profile pictures and QR code scanning.",
        "NSPhotoLibraryUsageDescription": "This app uses the photo library to upload profile pictures.",
        "NSLocationWhenInUseUsageDescription": "This app uses location to provide location-based services.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "givta"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      },
      "associatedDomains": [
        "applinks:givta.app"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4B0082"
      },
      "package": "com.unusualdan.Givta",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "com.android.alarm.permission.SET_ALARM"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "https",
            "host": "givta.app",
            "pathPrefix": "/tip"
          },
          "category": "BROWSABLE",
          "category": "DEFAULT"
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Givta",
      "shortName": "Givta",
      "lang": "en",
      "scope": "/",
      "themeColor": "#4B0082",
      "description": "Social payment & tipping app with referral rewards",
      "dir": "ltr",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "portrait",
      "backgroundColor": "#4B0082",
      "barStyle": "default",
      "dangerouslyGetFullBundleUrl": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4B0082",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 21,
            "buildToolsVersion": "34.0.0",
            "kotlinVersion": "1.9.0"
          },
      "ios": {
        "deploymentTarget": "15.1"
      }
        }
      ],

      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/your-project-id"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
